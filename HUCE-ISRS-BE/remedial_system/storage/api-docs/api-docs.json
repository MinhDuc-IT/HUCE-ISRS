        "/api/admin/users": {
            "get": {
                "tags": [
                    "Người dùng"
                ],
                "summary": "Danh sách người dùng",
                "description": "GET /api/admin/users\nDanh sách người dùng (Admin xem).",
                "operationId": "listUsers",
                "parameters": [
                    {
                        "name": "role",
                        "in": "query",
                        "description": "Lọc theo vai trò",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "enum": [
                                "admin",
                                "bo_mon",
                                "sinh_vien"
                            ]
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Danh sách người dùng"
                    },
                    "403": {
                        "description": "Không có quyền"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            },
            "post": {
                "tags": [
                    "Người dùng"
                ],
                "summary": "Thêm người dùng mới",
                "description": "Tạo tài khoản người dùng mới. Ràng buộc: student_code bắt buộc nếu role=sinh_vien, department_id bắt buộc nếu role=bo_mon.",
                "operationId": "createUser",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "name",
                                    "email",
                                    "password",
                                    "role"
                                ],
                                "properties": {
                                    "name": {
                                        "description": "Họ tên",
                                        "type": "string",
                                        "example": "Nguyễn Văn A"
                                    },
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "nguyenvana@remedial.edu.vn"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "password123"
                                    },
                                    "role": {
                                        "type": "string",
                                        "example": "bo_mon",
                                        "enum": [
                                            "admin",
                                            "bo_mon",
                                            "sinh_vien"
                                        ]
                                    },
                                    "student_code": {
                                        "description": "Bắt buộc nếu role là sinh_vien",
                                        "type": "string",
                                        "example": null,
                                        "nullable": true
                                    },
                                    "department_id": {
                                        "description": "Bắt buộc nếu role là bo_mon",
                                        "type": "integer",
                                        "example": 1,
                                        "nullable": true
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Thêm thành công – bước 5 Normal Flow",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Thêm người dùng thành công"
                                        },
                                        "data": {
                                            "type": "object"
                                        },
                                        "errors": {
                                            "type": "null"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Chưa xác thực"
                    },
                    "403": {
                        "description": "Không có quyền – chỉ Admin"
                    },
                    "422": {
                        "description": "AF-1: Thông tin không hợp lệ"
