        "/api/admin/tutoring-classes": {
            "get": {
                "tags": [
                    "Đợt phụ đạo"
                ],
                "summary": "Danh sách đợt phụ đạo",
                "description": "GET /api/admin/tutoring-classes",
                "operationId": "listTutoringClasses",
                "parameters": [
                    {
                        "name": "tutoring_term_id",
                        "in": "query",
                        "description": "Lọc theo đợt phụ đạo",
                        "required": false,
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "name": "status",
                        "in": "query",
                        "description": "Lọc theo trạng thái",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "enum": [
                                "open",
                                "full",
                                "closed",
                                "cancelled"
                            ]
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Thành công"
                    },
                    "403": {
                        "description": "Không có quyền"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            },
            "post": {
                "tags": [
                    "Đợt phụ đạo"
                ],
                "summary": "Thêm đợt phụ đạo mới",
                "description": "Tạo một đợt phụ đạo mới. Hệ thống kiểm tra ràng buộc thời gian: hạn đăng ký phải trước ngày bắt đầu, ngày kết thúc phải sau ngày bắt đầu.",
                "operationId": "createTutoringClass",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "course_code",
                                    "course_name",
                                    "credits",
                                    "tutoring_term_id",
                                    "max_students"
                                ],
                                "properties": {
                                    "course_code": {
                                        "description": "Mã môn học",
                                        "type": "string",
                                        "example": "CS101"
                                    },
                                    "course_name": {
                                        "description": "Tên môn học",
                                        "type": "string",
                                        "example": "Lập trình hướng đối tượng"
                                    },
                                    "credits": {
                                        "description": "Số tín chỉ",
                                        "type": "integer",
                                        "example": 3
                                    },
                                    "tutoring_term_id": {
                                        "description": "ID đợt phụ đạo",
                                        "type": "integer",
                                        "example": 1
                                    },
                                    "teacher_code": {
                                        "description": "Mã giảng viên (tuỳ chọn)",
                                        "type": "string",
                                        "example": "GV001",
                                        "nullable": true
                                    },
                                    "teacher_name": {
                                        "type": "string",
                                        "example": "Nguyễn Văn A",
                                        "nullable": true
                                    },
                                    "max_students": {
                                        "description": "Sĩ số tối đa",
                                        "type": "integer",
                                        "example": 30
                                    },
                                    "note": {
                                        "description": "Ghi chú",
                                        "type": "string",
                                        "example": "Ưu tiên sinh viên năm 3",
                                        "nullable": true
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Thêm đợt phụ đạo thành công",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Đợt phụ đạo đã được tạo thành công"
                                        },
                                        "data": {
                                            "type": "object"
                                        },
                                        "errors": {
                                            "type": "null"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
