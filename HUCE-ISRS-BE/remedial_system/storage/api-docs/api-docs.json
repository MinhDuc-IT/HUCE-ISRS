{
    "openapi": "3.0.0",
    "info": {
        "title": "Remedial Registration System API",
        "description": "Tài liệu API hệ thống đăng ký học phụ đạo",
        "contact": {
            "email": "admin@remedial.edu.vn"
        },
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://localhost:8000",
            "description": "API Server chính"
        }
    ],
    "paths": {
        "/api/auth/login": {
            "post": {
                "tags": [
                    "Xác thực"
                ],
                "summary": "Đăng nhập vào hệ thống",
                "description": "Admin/Bộ môn dùng email + password. Sinh viên dùng student_code + password (tự động tạo tài khoản lần đầu qua University System).",
                "operationId": "login",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "email": {
                                        "description": "Email – dùng cho Admin hoặc Bộ môn",
                                        "type": "string",
                                        "format": "email",
                                        "example": "admin@remedial.edu.vn",
                                        "nullable": true
                                    },
                                    "student_code": {
                                        "description": "Mã sinh viên – dùng cho Sinh viên",
                                        "type": "string",
                                        "example": "SV001",
                                        "nullable": true
                                    },
                                    "password": {
                                        "description": "Mật khẩu. Sinh viên đăng nhập lần đầu dùng mã sinh viên làm mật khẩu.",
                                        "type": "string",
                                        "format": "password",
                                        "example": "nuce_backdoor_2026"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Đăng nhập thành công"
                    },
                    "401": {
                        "description": "AF-2: Sai mật khẩu"
                    },
                    "404": {
                        "description": "AF-3: Sinh viên không tồn tại trên University System"
                    },
                    "422": {
                        "description": "AF-1: Dữ liệu đầu vào không hợp lệ"
                    },
                    "503": {
                        "description": "AF-4: University System không khả dụng"
                    }
                }
            }
        },
