        "/api/auth/login": {
            "post": {
                "tags": [
                    "Xác thực"
                ],
                "summary": "Đăng nhập vào hệ thống",
                "description": "Admin/Bộ môn dùng email + password. Sinh viên dùng student_code + password (tự động tạo tài khoản lần đầu qua University System).",
                "operationId": "login",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "admin@remedial.edu.vn",
                                        "nullable": true
                                    },
                                    "student_code": {
                                        "type": "string",
                                        "example": "SV001",
                                        "nullable": true
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "nuce_backdoor_2026"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Đăng nhập thành công"
                    },
                    "401": {
                        "description": "Sai thông tin đăng nhập"
                    },
                    "403": {
                        "description": "Tài khoản đã bị vô hiệu hóa"
                    },
                    "404": {
                        "description": "Sinh viên không tồn tại trên University System"
                    },
                    "422": {
                        "description": "Dữ liệu đầu vào không hợp lệ"
                    },
                    "503": {
                        "description": "University System không khả dụng"
                    }
                }
            }
        },
